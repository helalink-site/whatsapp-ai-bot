# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ld6juhMEAFeE1MBpEAhC
# Voice speed: 0.7 slower ... 1.0 normal ... 1.2 faster
ELEVENLABS_SPEED=1.0

# Business
OWNER_NAME=Clinton
OWNER_FULL_NAME=Clinton Oduor
BUSINESS_NAME=Skyline Technologies

# Your OTHER WhatsApp number(s) that control the bot, digits only, comma separated
OWNER_NUMBERS=
# "My people": numbers the bot never replies to and never handles calls for. Digits only, comma separated.
# Keep important ones here because contacts saved with /mine are lost if free hosting restarts.
PERSONAL_NUMBERS=

# The bot's number, used for the pairing code (no plus, no spaces)
PAIR_NUMBER=
# On a host, point this at a persistent volume, e.g. /data
# DATA_DIR=/data

# Language of all bot replies and voice notes
BOT_LANGUAGE=English
